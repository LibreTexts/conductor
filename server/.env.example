# Core Server Config
NODE_ENV=development
ORG_ID=<ORGID>
PORT=5000
SECRETKEY=<YOUR_SECRET_KEY>
LOG_LEVEL=debug
CLIENT_PORT=3000
CONDUCTOR_DOMAIN=<MAIN_CONDUCTOR_URL>
CONDUCTOR_SYSTEM_UUID=<CONDUCTOR_SYSTEM_UUID>
DEBUG=conductor
DEVELOPMENTURLS=http://localhost:3000

# ADAPT
ADAPT_LEARNING_ANALYTICS_UNSYNC_TOKEN=<YOUR_ADAPT_LEARNING_ANALYTICS_UNSYNC_TOKEN>

# AWS
AWS_PROFILE=<YOUR_AWS_CLI_PROFILE>
AWS_REGION=<YOUR_AWS_REGION>

AWS_SSM_LIB_TOKEN_PAIR_PATH=<YOUR_AWS_SSM_LIB_TOKEN_PAIR_PATH>

AWS_AUTHOR_IMAGES_BUCKET=<YOUR_AWS_AUTHOR_IMAGES_BUCKET>
AWS_AUTHOR_IMAGES_DOMAIN=<YOUR_AWS_AUTHOR_IMAGES_DOMAIN>

AWS_COLLECTIONDATA_BUCKET=<YOUR_AWS_COLLECTIONDATA_BUCKET>
AWS_COLLECTIONDATA_DOMAIN=<YOUR_AWS_COLLECTIONDATA_DOMAIN>

AWS_PROJECTFILES_BUCKET=<YOUR_AWS_PROJECTFILES_BUCKET>
AWS_PROJECTFILES_DOMAIN=<YOUR_AWS_PROJECTFILES_DOMAIN>
AWS_PROJECTFILES_KEYPAIR_ID=<YOUR_AWS_PROJECTFILES_KEYPAIR_ID>
AWS_PROJECTFILES_CLOUDFRONT_PRIVKEY=<YOUR_AWS_PROJECTFILES_CLOUDFRONT_PRIVKEY>

AWS_MATERIALS_BUCKET=<YOUR_AWS_MATERIALS_BUCKET>
AWS_MATERIALS_DOMAIN=<YOUR_AWS_MATERIALS_DOMAIN>
AWS_MATERIALS_KEYPAIR_ID=<YOUR_AWS_MATERIALS_KEYPAIR_ID>
AWS_MATERIALS_CLOUDFRONT_PRIVKEY=<YOUR_AWS_MATERIALS_CLOUDFRONT_PRIVKEY>

AWS_ORGDATA_BUCKET=<YOUR_AWS_ORGDATA_BUCKET>
AWS_ORGDATA_DOMAIN=<YOUR_AWS_ORGDATA_DOMAIN>

AWS_USERDATA_BUCKET=<YOUR_AWS_USERDATA_BUCKET>
AWS_USERDATA_DOMAIN=<YOUR_AWS_USERDATA_DOMAIN>

AWS_KBFILES_BUCKET=<YOUR_AWS_KBFILES_BUCKET>
AWS_KBFILES_DOMAIN=<YOUR_AWS_KBFILES_DOMAIN>

AWS_SUPPORTFILES_BUCKET=<YOUR_AWS_SUPPORTFILES_BUCKET>
AWS_SUPPORTFILES_DOMAIN=<YOUR_AWS_SUPPORTFILES_DOMAIN>
AWS_SUPPORTFILES_KEYPAIR_ID=<YOUR_AWS_SUPPORTFILES_KEYPAIR_ID>
AWS_SUPPORTFILES_CLOUDFRONT_PRIVKEY=<YOUR_AWS_SUPPORTFILES_CLOUDFRONT_PRIVKEY>

AWS_PROJECT_THUMBNAILS_BUCKET=<YOUR_AWS_PROJECT_THUMBNAILS_BUCKET>
AWS_PROJECT_THUMBNAILS_DOMAIN=<YOUR_AWS_PROJECT_THUMBNAILS_DOMAIN>

# Learning Analytics
LEARNING_ANALYTICS_INIT_URL=http://localhost:7000/api/init

# H5P
H5P_SERVICE_URL=http://localhost:5100
H5P_CAPABILITY_PRIVATE_KEY=<H5P_CAPABILITY_PRIVATE_KEY>

# Rate limiting
TRUST_PROXY_HOPS=0

# Mailgun
MAILGUN_API_KEY=<YOUR_MAILGUN_API_KEY>
MAILGUN_DOMAIN=<YOUR_MAILGUN_DOMAIN>

# MongoDB
MONGOOSEURI=<YOUR_MONGOOSE_CONNECTION_STRING>

# Stripe
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>

# LibreOne/Central Identity
CENTRAL_IDENTITY_URL=http://localhost:5001/api/v1
CENTRAL_IDENTITY_USER=<YOUR_CENTRAL_IDENTITY_USER>
CENTRAL_IDENTITY_KEY=<YOUR_CENTRAL_IDENTITY_KEY>
CENTRAL_IDENTITY_WEBHOOK_SECRET=<YOUR_CENTRAL_IDENTITY_WEBHOOK_SECRET>
LIBRE_API_KEY=<YOUR_LIBRE_API_KEY>
LIBRE_SUBDOMAIN=<ORG_COMMONS_SUBDOMAIN>
LIBREONE_LIFECYCLE_WEBHOOK_SIGNING_KEY=<YOUR_LIBREONE_LIFECYCLE_WEBHOOK_SIGNING_KEY>

# CXOne/AWS SSM
CXONE_API_USERNAME=<YOUR_CXONE_API_USERNAME>

# Cloudflare
CLOUDFLARE_STREAM_ACCOUNT_ID=<YOUR_CLOUDFLARE_STREAM_ACCOUNT_ID>
CLOUDFLARE_STREAM_API_TOKEN=<YOUR_CLOUDFLARE_STREAM_API_TOKEN>
CLOUDFLARE_STREAM_CUSTOMER_CODE=<YOUR_CLOUDFLARE_STREAM_CUSTOMER_CODE>

# OpenAI
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# Lulu/Bookstore
LULU_CLIENT_ID=<YOUR_LULU_CLIENT_ID>
LULU_CLIENT_SECRET=<YOUR_LULU_CLIENT_SECRET>
BOOKSTORE_CONTACT_EMAIL=<YOUR_BOOKSTORE_CONTACT_EMAIL>
STRIPE_STORE_WEBHOOK_SECRET=<YOUR_STRIPE_STORE_WEBHOOK_SECRET>
GOOGLE_MAPS_API_KEY=<YOUR_GOOGLE_MAPS_API_KEY>

# Qdrant
#QDRANT_URL=http://localhost:6333
#QDRANT_API_KEY=<YOUR_QDRANT_API_KEY>

# Client Config
CLIENT__MAIN_COMMONS_URL=http://localhost:3000
CLIENT__INSTRUCTOR_VERIFICATION_URL=http://localhost:5000/instructor
CLIENT__CENTRAL_IDENTITY_BASE_URL=http://localhost:5000
CLIENT__H5P_EMBED_ORIGIN=http://localhost:5100
CLIENT__H5P_AUTHORING_ENABLED="true"
CLIENT__REFERENCE_MANAGER_ENABLED="true"

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=<YOUR_MEILISEARCH_API_KEY>

# Shapeshift
SHAPESHIFT_HOST=http://localhost:8000
SHAPESHIFT_WEBHOOK_KEY=<YOUR_SHAPESHIFT_WEBHOOK_KEY>
DOWNLOADS_BASE_URL=http://localhost:8000

# Library Sync
LIBRARY_SYNC_ONLY=chem                    # comma-separated subdomains
LIBRARY_SYNC_MAX_LIBRARIES=2              # first N libraries
LIBRARY_SYNC_MAX_BOOKS_PER_LIBRARY=10     # first N books each
